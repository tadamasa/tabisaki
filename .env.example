# 縁泉スプレッドシートを読む Apps Script（gas/ensen-api.gs）のウェブアプリ URL と合言葉
ENSEN_GAS_URL=https://script.google.com/macros/s/xxxxxxxx/exec
ENSEN_GAS_TOKEN=

# ローカル開発で、スプレッドシートの代わりに縁泉のエクスポート（xlsx）を読む場合
# ENSEN_XLSX=/path/to/ensen.xlsx

# 自宅の位置（緯度,経度）。距離の計算に使う
HOME_LATLNG=34.7617,135.5157

# 設定すると、すべてのページに合言葉（Basic 認証）がかかる。公開するときは必ず設定する
APP_PASSWORD=

# 地帯の神社・資料館を探す OpenStreetMap（Overpass API）の窓口。カンマ区切りで予備を並べられる
# OVERPASS_URL=https://overpass-api.de/api/interpreter,https://overpass.kumi.systems/api/interpreter
